# PostgreSQL
DATABASE_URL=postgresql://postgres:password@postgres:5432/attendance_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=attendance_db

# MinIO credentials
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=student-attendance

# Internal service connection (inside Docker)
MINIO_HOST=minio:9000

# Public URL for users (mapped host port)
MINIO_PUBLIC_URL=http://10.129.2.182:9090

# Not using HTTPS
MINIO_SECURE=false
